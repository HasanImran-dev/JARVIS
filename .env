# =====================================================================
# JARVIS-ULTRON AGENT HQ v17.0 — ENVIRONMENT CONFIGURATION
# Copy this file to .env and insert your personal API credentials:
#   cp .env.example .env
# =====================================================================

# DeepSeek Cloud API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Default Brain. SAFE MODE DEFAULTS TO "ollama:llama3.1" to avoid exposing local shells.
DEFAULT_ENGINE="ollama:llama3.1"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Security defaults: safest option is OFF unless you explicitly trust this machine.
SAFE_MODE="true"
ALLOW_SHELL_EXECUTION="false"
ALLOW_PYTHON_EXECUTION="false"
VOICE_ENABLED="false"
