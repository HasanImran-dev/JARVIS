# DeepSeek Cloud API Key (https://platform.deepseek.com/)
DEEPSEEK_API_KEY="your_deepseek_api_key_here"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Default Brain ("deepseek-chat" or "ollama:llama3.1" or "ollama:gemma2")
DEFAULT_ENGINE="deepseek-chat"
OLLAMA_BASE_URL="http://localhost:11434/v1"

# Security & Voice Preferences
ALLOW_SHELL_EXECUTION="true"
VOICE_ENABLED="true"
